#!/bin/bash
#  _______   _______
# |  _____| |  ___  |
# | |       | |   | |    Rolando Ramos Torres (@rolodoom)
# | |       | |___| |    http://rolandoramostorres.com
# |_|       |_______|
#  _         _______     r_extractsubs
# | |       |  ___  |
# | |       | |   | |    Extract subtitles from MKV files
# | |_____  | |___| |    into ASS formating
# |_______| |_______|
# 
#

set -euo pipefail

show_help() {
    echo "Usage: $(basename "$0") [-i subtitle_track] <input.mkv>"
    echo
    echo "Extract a subtitle track from an MKV file, repair ASS formatting,"
    echo "convert it to SRT, and clean generated HTML subtitle tags."
    echo
    echo "Options:"
    echo "  -i NUM    Subtitle track to extract (default: 2)"
    echo "  -h        Show this help"
    echo
    echo "Examples:"
    echo "  $(basename "$0") movie.mkv"
    echo "  $(basename "$0") -i 4 movie.mkv"
    echo "  $(basename "$0") -i 7 movie.mkv"
}

# Default subtitle track
SUBTITLE_TRACK=2
CUSTOM_TRACK=false

# Parse options
while getopts ":i:h" opt; do
    case "$opt" in
        i)
            if [[ ! "$OPTARG" =~ ^[0-9]+$ ]]; then
                echo "Error: subtitle track must be a number: $OPTARG"
                exit 1
            fi

            SUBTITLE_TRACK="$OPTARG"
            CUSTOM_TRACK=true
            ;;
        h)
            show_help
            exit 0
            ;;
        \?)
            echo "Error: invalid option: -$OPTARG"
            show_help
            exit 1
            ;;
        :)
            echo "Error: option -$OPTARG requires a number."
            show_help
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

# Check input file
if [ $# -lt 1 ]; then
    show_help
    exit 1
fi

MKV_FILE="$1"

if [ ! -f "$MKV_FILE" ]; then
    echo "Error: file not found: $MKV_FILE"
    exit 1
fi

BASE_NAME="${MKV_FILE%.mkv}"

# If a custom track was specified, prefix the track number
if [ "$CUSTOM_TRACK" = true ]; then
    ASS_FILE="${BASE_NAME}.${SUBTITLE_TRACK}.ass"
else
    ASS_FILE="${BASE_NAME}.en.ass"
fi

echo "Extracting subtitle track $SUBTITLE_TRACK..."
mkvextract tracks "$MKV_FILE" "$SUBTITLE_TRACK:$ASS_FILE"

echo "Repairing ASS file..."
sed -i 's/^Dialogue: ,/Dialogue: 0,/' "$ASS_FILE"

#SRT_FILE="${BASE_NAME}.srt"

#echo "Converting ASS to SRT..."
#ffmpeg -y -i "$ASS_FILE" "$SRT_FILE"

#echo "Cleaning HTML subtitle tags..."
#sed -i -E 's/<[^>]+>//g' "$SRT_FILE"

echo "Done."
echo "Generated files:"
echo "  $ASS_FILE"
#echo "  $SRT_FILE"
